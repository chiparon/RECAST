{
  "name": "@forexplore/adaptation-service",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node ../../scripts/build-agent-skills.mjs",
    "prestart": "node ../../scripts/build-agent-skills.mjs",
    "prebuild": "node ../../scripts/build-agent-skills.mjs",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src"
  },
  "exports": {
    ".": "./src/index.ts",
    "./git-wave-transaction": "./src/git-wave-transaction.ts",
    "./compiler": "./src/compiler.ts",
    "./project-pipeline": "./src/project-pipeline.ts",
    "./codex-workspace-translation-runtime": "./src/codex-workspace-translation-runtime.ts",
    "./integration-plan-agent": "./src/integration-plan-agent.ts",
    "./module-patch-preparer": "./src/module-patch-preparer.ts",
    "./workspace-translation-runtime": "./src/workspace-translation-runtime.ts",
    "./workspace-compiler": "./src/workspace-compiler.ts",
    "./module-wave-execution": "./src/module-wave-execution.ts"
  },
  "types": "./src/index.ts",
  "dependencies": {
    "@forexplore/code-intelligence-service": "0.1.0",
    "@forexplore/code-indexer": "0.1.0",
    "@forexplore/contracts": "0.1.0",
    "@forexplore/workflow-core": "0.1.0",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
