# Git worktrees
.worktrees/

# 误提交过一次的类别（见 scripts/check-repo-hygiene.mjs 的门禁）
# 1) 带空格的 "xxx - 副本" 整棵复制目录（含 skeleton 的完整拷贝）
**/* - 副本/
# 2) 归档与比赛材料（大体积二进制应放 release/外部存储，不进 git）
*.zip
# 3) .NET 构建产物（历史上已跟踪 20 个，勿再新增）
fixtures/code-corpus/**/obj/
# 4) 临时截图
apps/vscode-extension/webview/image.png
# 5) 资产升级数据集：原始仓库与冻结清单体积过大，由 materialize.py 复现
experiments/enterprise-asset-upgrade/source-repositories/
experiments/enterprise-asset-upgrade/asset-manifest.json
# 6) 实验工程的 .NET 构建产物（本地编译产生，不属于数据集）
experiments/**/obj/
experiments/**/bin/
# Verifier and other .NET fixture build intermediates
**/obj/
# Dated local experiment runs and machine diagnostics
experiments/enterprise-asset-upgrade/*java*-20*/
windows-usage.txt
winsxs-usage.txt
# Generated Coding Agent baseline runs (keep the checked-in README).
experiments/enterprise-asset-upgrade/results/*
!experiments/enterprise-asset-upgrade/results/README.md

# Per-machine Windows/WSL workspace mapping and source sync baseline
.recast-platforms.json
.recast-platform-sync.json
