{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "rootDir": "..",
    "types": ["node"],
    "resolveJsonModule": true
  },
  "include": [
    "../packages/contracts/src",
    "../packages/adaptation-http-adapter/src",
    "../services/translation-verifier/src",
    "../tests/**/*.ts"
  ]
}
